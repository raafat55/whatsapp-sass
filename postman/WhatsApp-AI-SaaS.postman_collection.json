{
  "info": {
    "name": "WhatsApp AI SaaS API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "sessionId", "value": "" },
    { "key": "contactId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "Sessions",
      "item": [
        {
          "name": "Create session",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"label\": \"Main\"\n}" },
            "url": "{{baseUrl}}/api/sessions"
          }
        },
        {
          "name": "List sessions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/sessions"
          }
        },
        {
          "name": "Get session",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/sessions/{{sessionId}}"
          }
        },
        {
          "name": "Start session (QR in server logs)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/sessions/{{sessionId}}/start"
          }
        },
        {
          "name": "Stop session",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/sessions/{{sessionId}}/stop"
          }
        },
        {
          "name": "Send WhatsApp message",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"to\": \"2010123456789\",\n  \"text\": \"Hello from the API\"\n}"
            },
            "url": "{{baseUrl}}/api/sessions/{{sessionId}}/send"
          }
        },
        {
          "name": "Delete session",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/sessions/{{sessionId}}"
          }
        }
      ]
    },
    {
      "name": "Contacts",
      "item": [
        {
          "name": "Sync contacts",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/contacts/{{sessionId}}/sync"
          }
        },
        {
          "name": "List contacts",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/contacts/{{sessionId}}?limit=50&page=1"
          }
        },
        {
          "name": "Delete contact",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/contacts/{{contactId}}"
          }
        }
      ]
    },
    {
      "name": "AI Agents",
      "item": [
        {
          "name": "List all agents",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/ai-agents"
          }
        },
        {
          "name": "Get agent for session",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/sessions/{{sessionId}}/ai-agent"
          }
        },
        {
          "name": "Create or update agent (session)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"geminiApiKey\": \"YOUR_GEMINI_KEY\",\n  \"displayName\": \"Support\",\n  \"businessName\": \"Acme Inc\",\n  \"businessDescription\": \"We sell quality hardware. Reply with product questions and shipping info.\",\n  \"languagePreference\": \"en\",\n  \"toneOfVoice\": \"professional\",\n  \"extraInstructions\": \"Never promise discounts without approval.\",\n  \"modelName\": \"gemini-1.5-flash\",\n  \"enabled\": true\n}"
            },
            "url": "{{baseUrl}}/api/sessions/{{sessionId}}/ai-agent"
          }
        },
        {
          "name": "Patch agent (enable/disable)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"enabled\": false\n}" },
            "url": "{{baseUrl}}/api/sessions/{{sessionId}}/ai-agent"
          }
        },
        {
          "name": "Delete agent (unassign)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/sessions/{{sessionId}}/ai-agent"
          }
        }
      ]
    },
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    }
  ]
}
