# DATABASE (MongoDB Atlas recommended for production)
# Format: mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
MONGO_URI=mongodb://raafatsamy109:hQm3tZYWWEjNI2WS@ac-phjothd-shard-00-00.jdjy8pd.mongodb.net:27017,ac-phjothd-shard-00-01.jdjy8pd.mongodb.net:27017,ac-phjothd-shard-00-02.jdjy8pd.mongodb.net:27017/?replicaSet=atlas-12rk7b-shard-0&ssl=true&authSource=admin&retryWrites=true&w=majority&appName=Cluster0
# SERVER CONFIGURATION
PORT=3000
NODE_ENV=production

# SECURITY: JWT Secret (authentication tokens)
# - MINIMUM 32 characters in production (enforced by validation)
# - Use: openssl rand -base64 32
# - Production value: Generate with crypto library or key manager
JWT_SECRET=9f7d6e1c8a3b0e5d1f3a2b4c6e7d8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e

# SECURITY: Encryption Key (AES-256-GCM for Gemini API key encryption)
# - EXACTLY 64 hexadecimal characters (= 32 bytes)
# - Use: openssl rand -hex 32
# - Production value: Store in Render.com secrets or use managed key service
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# CORS Configuration (production only, separate by comma for multiple origins)
# - Development: defaults to '*' (all origins)
# - Production: specify exact origins, e.g. https://app.example.com,https://app2.example.com
# - Never expose API to all origins in production
CORS_ORIGIN=https://refqoquizbot.onrender.com

# AI CONFIGURATION
# Rate limiting: max AI replies per minute (per agent instance, in-memory)
# - Recommended: 30 for production (prevents cost overruns)
# - Minimum: 5, Maximum: 100
AI_REPLY_MAX_PER_MINUTE=30

# Memory management: max conversation messages kept in context
# - Recommended: 30 for balanced performance/cost
# - Lower values: faster, less context, cheaper
# - Higher values: more context, slower, more expensive
# - Maximum: 100 (enforced by validation)
AI_MEMORY_MAX_MESSAGES=30

# =============================================================================
# RENDER.COM DEPLOYMENT NOTES
# =============================================================================
# 1. Set Node version: settings -> build command -> node version 20.x
# 2. Add all above variables in Render.com Environment section
# 3. JWT_SECRET: Generate 32+ random chars with: crypto.randomBytes(32).toString('hex')
# 4. ENCRYPTION_KEY: Generate 64 hex chars with: crypto.randomBytes(32).toString('hex')
# 5. MONGO_URI: Get from MongoDB Atlas cluster connection string
# 6. CORS_ORIGIN: Set to your frontend domain (e.g., https://app.example.com)
#
# MongoDB Atlas Setup (recommended):
# - Create free tier cluster (M0: 512MB storage, adequate for MVP)
# - Whitelist Render.com IP: 0.0.0.0/0 (allows Render IP ranges)
# - Create dedicated database user
# - Get connection string: Copy "Connect" -> "Drivers" -> Node.js
# 
# Health Check: Render auto-monitors /health endpoint (no config needed)
# Logs: View in Render.com dashboard or via `render logs` CLI
# Auto-deploy: Push to GitHub main branch for automatic deployment
# =============================================================================

